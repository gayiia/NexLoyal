    }

    function loadDashboard(token) {
      var dataUrl = config.dataUrl + '?token=' + encodeURIComponent(token);
      fetch(dataUrl, { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || typeof data.points === 'undefined') {
            throw new Error('Data missing');
          }
          renderDashboard(data);
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to load your rewards right now. Please try again.</p>';
        });
    }

    function renderLoggedIn(customer) {
      content.innerHTML = '' +
        '<div class="nexloyal-loading">' +
          '<div class="nexloyal-spinner" aria-label="Loading"></div>' +
        '</div>';

      var tokenUrl = config.tokenUrl +
        '?customer_id=' + encodeURIComponent(config.customerId || customer.id || '') +
        '&email=' + encodeURIComponent(config.customerEmail || customer.email || '') +
        '&shop_domain=' + encodeURIComponent(config.shopDomain);

      fetch(tokenUrl, { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || !data.token) {
            throw new Error('Token missing');
          }
          config.currentToken = data.token;
          loadDashboard(data.token);
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to open the dashboard right now. Please try again.</p>';
        });
    }

    function renderProfileForm() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>Complete your profile</h2>' +
            '<p>Update your details to earn rewards.</p>' +
          '</div>' +
          '<form id="nexloyal-profile-form" class="nexloyal-form">' +
            '<div>' +
              '<label for="nexloyal-first-name">First name</label>' +
              '<input id="nexloyal-first-name" class="nexloyal-input" type="text" name="first_name" autocomplete="given-name">' +
            '</div>' +
            '<div>' +
              '<label for="nexloyal-last-name">Last name</label>' +
              '<input id="nexloyal-last-name" class="nexloyal-input" type="text" name="last_name" autocomplete="family-name">' +
            '</div>' +
            '<div>' +
              '<label for="nexloyal-email">Email</label>' +
              '<input id="nexloyal-email" class="nexloyal-input" type="email" name="email" autocomplete="email" required>' +
            '</div>' +
            '<div>' +
              '<label for="nexloyal-phone">Phone</label>' +
              '<input id="nexloyal-phone" class="nexloyal-input" type="tel" name="phone" autocomplete="tel">' +
            '</div>' +
            '<div>' +
              '<label for="nexloyal-birthday">Birthday</label>' +
              '<input id="nexloyal-birthday" class="nexloyal-input" type="date" name="birthday">' +
            '</div>' +
            '<div class="nexloyal-form-actions">' +
              '<button type="submit">Save profile</button>' +
              '<button type="button" id="nexloyal-profile-cancel" class="nexloyal-secondary">Back</button>' +
            '</div>' +
          '</form>' +
        '</div>';

      var profileUrl = config.dataUrl.replace('/loyalty/data', '/loyalty/profile') +
        '?token=' + encodeURIComponent(config.currentToken);

      fetch(profileUrl, { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
          .then(function(profile) {
            document.getElementById('nexloyal-first-name').value = profile.first_name || '';
            document.getElementById('nexloyal-last-name').value = profile.last_name || '';
            document.getElementById('nexloyal-email').value = profile.email || '';
            document.getElementById('nexloyal-phone').value = profile.phone || '';
            document.getElementById('nexloyal-birthday').value = profile.birthday || '';
          });

      document.getElementById('nexloyal-profile-cancel').addEventListener('click', function () {
        loadDashboard(config.currentToken);
      });

      document.getElementById('nexloyal-profile-form').addEventListener('submit', function (event) {
        event.preventDefault();
        var payload = {
          first_name: document.getElementById('nexloyal-first-name').value,
          last_name: document.getElementById('nexloyal-last-name').value,
          email: document.getElementById('nexloyal-email').value,
          phone: document.getElementById('nexloyal-phone').value,
          birthday: document.getElementById('nexloyal-birthday').value || null
        };

        fetch(profileUrl, {
          method: 'POST',
          mode: 'cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || data.message !== 'Profile updated.') {
              throw new Error('Profile update failed');
            }
            loadDashboard(config.currentToken);
          })
          .catch(function() {
            content.innerHTML = '<p>Unable to save your profile right now. Please try again.</p>';
        });
      });
    }

    function getCouponsUrl() {
      return config.couponsUrl + '?token=' + encodeURIComponent(config.currentToken);
    }

    function getRedeemUrl(couponId) {
      return config.couponsUrl + '/' + encodeURIComponent(couponId) + '/redeem?token=' + encodeURIComponent(config.currentToken);
    }

    function getMyCouponsUrl() {
      return config.myCouponsUrl + '?token=' + encodeURIComponent(config.currentToken);
    }

    function getMyCouponDetailUrl(redemptionId) {
      return config.myCouponsUrl + '/' + encodeURIComponent(redemptionId) + '?token=' + encodeURIComponent(config.currentToken);
    }

    function formatStatusLabel(status) {
      if (!status) {
        return 'Unused';
      }
      var normalized = status.toString().toLowerCase();
      if (normalized === 'used') {
        return 'Used';
      }
      if (normalized === 'in_progress') {
        return 'On hold';
      }
      if (normalized === 'expired') {
        return 'Expired';
      }
      return 'Unused';
    }

    function statusClassFromLabel(label) {
      if (label === 'Used') {
        return 'nexloyal-badge is-used';
      }
      if (label === 'On hold') {
        return 'nexloyal-badge';
      }
      if (label === 'Expired') {
        return 'nexloyal-badge is-used';
      }
      return 'nexloyal-badge';
    }

    function formatDateLabel(dateString) {
      if (!dateString) {
        return 'No expiry';
      }
      var date = new Date(dateString);
      if (isNaN(date.getTime())) {
        return 'No expiry';
      }
      return date.toISOString().slice(0, 10);
    }

    function maskCode(code) {
      if (!code) {
        return 'Code unavailable';
      }
      if (code.length <= 6) {
        return code;
      }
      return code.slice(0, 4) + '•••' + code.slice(-2);
    }

    function copyToClipboard(text, button) {
      if (!text) {
        return;
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          if (button) {
            button.textContent = 'Copied';
          }
        });
        return;
      }

      var tempInput = document.createElement('input');
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);
      if (button) {
        button.textContent = 'Copied';
      }
    }

    function renderMyCouponsList() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>My coupons</h2>' +
            '<p>Your redeemed rewards.</p>' +
          '</div>' +
          '<div id="nexloyal-my-coupon-list" class="nexloyal-list"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-my-coupon-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-my-coupon-back').addEventListener('click', function () {
        loadDashboard(config.currentToken);
      });

      var listEl = document.getElementById('nexloyal-my-coupon-list');
      listEl.innerHTML = '<div class="nexloyal-loading"><div class="nexloyal-spinner" aria-label="Loading"></div></div>';

      fetch(getMyCouponsUrl(), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || !Array.isArray(data.coupons)) {
            throw new Error('My coupon data missing');
          }

          if (!data.coupons.length) {
            listEl.innerHTML = '<div class="nexloyal-muted">No redeemed coupons yet.</div>';
            return;
          }

          var couponIndex = {};
          var rows = data.coupons.map(function (coupon) {
            couponIndex[coupon.redemption_id || coupon.id] = coupon;
            var statusLabel = formatStatusLabel(coupon.status);
            var statusClass = statusClassFromLabel(statusLabel);
            var codeLabel = maskCode(coupon.shopify_discount_code || coupon.code);
            var expiryLabel = formatDateLabel(coupon.expires_at);
            var titleLabel = coupon.coupon_title || coupon.title || 'Coupon';
            var valueLabel = coupon.coupon_value_label || (typeof coupon.coupon_points === 'number' ? (coupon.coupon_points + ' points') : 'Value unavailable');
            return '' +
              '<div class="nexloyal-row" data-coupon-id="' + (coupon.redemption_id || coupon.id) + '">' +
                '<div>' +
                  '<div class="nexloyal-row-title">' + titleLabel + '</div>' +
                  '<div class="nexloyal-row-sub">' + valueLabel + ' | ' + codeLabel + ' | ' + expiryLabel + '</div>' +
                '</div>' +
                '<div class="nexloyal-row-actions">' +
                  '<span class="' + statusClass + '">' + statusLabel + '</span>' +
                  '<button type="button" class="nexloyal-action" data-view-my-coupon="' + (coupon.redemption_id || coupon.id) + '">View</button>' +
                '</div>' +
              '</div>';
          }).join('');

          config.myCouponIndex = couponIndex;
          listEl.innerHTML = rows;

          listEl.querySelectorAll('[data-view-my-coupon]').forEach(function (button) {
            button.addEventListener('click', function () {
              var couponId = button.getAttribute('data-view-my-coupon');
              fetch(getMyCouponDetailUrl(couponId), { method: 'GET', mode: 'cors' })
                .then(function(response) { return response.json(); })
                .then(function(payload) {
                  var coupon = payload && payload.coupon ? payload.coupon : (config.myCouponIndex ? config.myCouponIndex[couponId] : null);
                  renderMyCouponDetail(coupon);
                })
                .catch(function() {
                  renderMyCouponDetail(config.myCouponIndex ? config.myCouponIndex[couponId] : null);
                });
            });
          });
        })
        .catch(function() {
          listEl.innerHTML = '<div class="nexloyal-error">Unable to load coupons right now. Please try again.</div>';
        });
    }

    function renderMyCouponDetail(coupon) {
      if (!coupon) {
        renderMyCouponsList();
        return;
      }

      var statusLabel = formatStatusLabel(coupon.status);
      var statusClass = statusClassFromLabel(statusLabel);
      var codeLabel = coupon.shopify_discount_code || coupon.code || 'Code unavailable';
      var expiryLabel = formatDateLabel(coupon.expires_at);
      var titleLabel = coupon.coupon_title || coupon.title || 'Coupon';
      var valueLabel = coupon.coupon_value_label || (typeof coupon.coupon_points === 'number' ? (coupon.coupon_points + ' points') : 'Value unavailable');

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>' + titleLabel + '</h2>' +
            '<p>Value: ' + valueLabel + '. Valid until ' + expiryLabel + '.</p>' +
          '</div>' +
          '<div class="nexloyal-card">' +
            '<div class="' + statusClass + '">' + statusLabel + '</div>' +
            '<div class="nexloyal-code" style="margin-top:12px;">' + codeLabel + '</div>' +
          '</div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-copy-code"' + ((coupon.shopify_discount_code || coupon.code) ? '' : ' disabled') + '>Copy code</button>' +
            '<button type="button" id="nexloyal-my-coupon-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-my-coupon-back').addEventListener('click', function () {
        renderMyCouponsList();
      });

      var copyButton = document.getElementById('nexloyal-copy-code');
      if (copyButton) {
        copyButton.addEventListener('click', function () {
          copyToClipboard(coupon.shopify_discount_code || coupon.code, copyButton);
        });
      }
    }

    function renderCouponsList() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>Redeem points</h2>' +
            '<p>Choose a reward to spend your points.</p>' +
          '</div>' +
          '<div class="nexloyal-muted">You have <span id="nexloyal-coupon-points">0</span> points.</div>' +
          '<div id="nexloyal-coupon-list" class="nexloyal-list"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-coupon-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-coupon-back').addEventListener('click', function () {
        loadDashboard(config.currentToken);
      });

      var listEl = document.getElementById('nexloyal-coupon-list');
      listEl.innerHTML = '<div class="nexloyal-loading"><div class="nexloyal-spinner" aria-label="Loading"></div></div>';

      fetch(getCouponsUrl(), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || !Array.isArray(data.coupons)) {
            throw new Error('Coupon data missing');
          }

          config.currentPoints = data.points || 0;
          var pointsEl = document.getElementById('nexloyal-coupon-points');
          if (pointsEl) {
            pointsEl.textContent = config.currentPoints;
          }

          if (!data.coupons.length) {
            listEl.innerHTML = '<div class="nexloyal-muted">No coupons available for your tier right now.</div>';
            return;
          }

          var couponIndex = {};
          var rows = data.coupons.map(function (coupon) {
            couponIndex[coupon.id] = coupon;
            return '' +
              '<div class="nexloyal-row" data-coupon-id="' + coupon.id + '">' +
                '<div>' +
                  '<div class="nexloyal-row-title">' + coupon.title + '</div>' +
                  '<div class="nexloyal-row-sub">' + coupon.points_value + ' points</div>' +
                '</div>' +
                '<div class="nexloyal-row-actions">' +
                  '<button type="button" class="nexloyal-action" data-view-coupon="' + coupon.id + '">View</button>' +
                '</div>' +
              '</div>';
          }).join('');

          config.couponIndex = couponIndex;
          listEl.innerHTML = rows;

          listEl.querySelectorAll('[data-view-coupon]').forEach(function (button) {
            button.addEventListener('click', function () {
              var couponId = button.getAttribute('data-view-coupon');
              renderCouponDetail(config.couponIndex ? config.couponIndex[couponId] : null);
            });
          });
        })
        .catch(function() {
          listEl.innerHTML = '<div class="nexloyal-error">Unable to load coupons right now. Please try again.</div>';
        });
    }

    function renderCouponDetail(coupon) {
      if (!coupon) {
        renderCouponsList();
        return;
      }

      var pointsCost = coupon.points_value || 0;
      var remainingPoints = typeof config.currentPoints === 'number' ? config.currentPoints : 0;
      var canRedeem = remainingPoints >= pointsCost;

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>' + coupon.title + '</h2>' +
            '<p>Redeem for ' + pointsCost + ' points.</p>' +
          '</div>' +
          '<div class="nexloyal-card">' +
            '<h4>About this coupon</h4>' +
            '<p>' + (coupon.description || 'No description available.') + '</p>' +
            '<div class="nexloyal-muted">You have ' + remainingPoints + ' points.</div>' +
          '</div>' +
          '<div id="nexloyal-redeem-error" class="nexloyal-error"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-redeem-button"' + (canRedeem ? '' : ' disabled') + '>Redeem for ' + pointsCost + ' points</button>' +
            '<button type="button" id="nexloyal-redeem-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-redeem-back').addEventListener('click', function () {
        renderCouponsList();
      });

      var redeemButton = document.getElementById('nexloyal-redeem-button');
      redeemButton.addEventListener('click', function () {
        if (redeemButton.disabled) {
          return;
        }

        redeemButton.disabled = true;
        redeemButton.textContent = 'Redeeming...';

        fetch(getRedeemUrl(coupon.id), { method: 'POST', mode: 'cors' })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || !data.code) {
              throw new Error((data && data.message) || 'Redeem failed');
            }

            config.currentPoints = data.points || 0;
            content.innerHTML = '' +
              '<div class="nexloyal-dashboard">' +
                '<div class="nexloyal-welcome">' +
                  '<h2>Coupon unlocked</h2>' +
                  '<p>Use this code at checkout.</p>' +
                '</div>' +
                '<div class="nexloyal-card">' +
                  '<h4>' + coupon.title + '</h4>' +
                  '<div class="nexloyal-code">' + data.code + '</div>' +
                  '<p class="nexloyal-muted" style="margin-top:12px;">Remaining points: ' + config.currentPoints + '</p>' +
                '</div>' +
                '<div class="nexloyal-form-actions">' +
                  '<button type="button" id="nexloyal-coupon-more">View more coupons</button>' +
                  '<button type="button" id="nexloyal-coupon-done" class="nexloyal-secondary">Back to rewards</button>' +
                '</div>' +
              '</div>';

            document.getElementById('nexloyal-coupon-more').addEventListener('click', function () {
              renderCouponsList();
            });
            document.getElementById('nexloyal-coupon-done').addEventListener('click', function () {
              loadDashboard(config.currentToken);
            });
          })
          .catch(function(error) {
            var errorEl = document.getElementById('nexloyal-redeem-error');
            if (errorEl) {
              errorEl.textContent = error.message || 'Unable to redeem this coupon. Please try again.';
            }
            redeemButton.disabled = false;
            redeemButton.textContent = 'Redeem for ' + pointsCost + ' points';
          });
      });
    }

    trigger.addEventListener('click', function() {
      openModal();
      if (!config.customerId || !config.customerEmail) {
        renderLoggedOut();
        return;
      }
      renderLoggedIn(config.customer);
    });

    closeButton.addEventListener('click', closeModal);
    modal.addEventListener('click', function(event) {
      if (event.target === modal) {
        closeModal();
      }
    });
  })();
</script>
