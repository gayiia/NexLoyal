<!-- Nexloyal floating widget (paste before </body> in theme.liquid) -->
<div id="nexloyal-widget">
  <button id="nexloyal-trigger" type="button" aria-haspopup="dialog" aria-controls="nexloyal-modal" aria-label="Open rewards">
    <span class="nexloyal-icon">★</span>
    <span class="nexloyal-label">Rewards</span>
  </button>
  <div id="nexloyal-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div id="nexloyal-panel">
      <div id="nexloyal-header">
        <div>
          <div class="nexloyal-eyebrow">Rewards</div>
          <div class="nexloyal-title">NexLoyal</div>
        </div>
        <button id="nexloyal-close" type="button" aria-label="Close">&times;</button>
      </div>
      <div id="nexloyal-content"></div>
    </div>
  </div>
</div>

<style>
  #nexloyal-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 2147483647;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  #nexloyal-trigger {
    background: #111827;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 16px;
    height: 48px;
    border-radius: 999px;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.2);
  }
  .nexloyal-icon {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: radial-gradient(circle at top, #fbbf24, #f97316);
    display: grid;
    place-items: center;
    font-size: 14px;
    color: #111827;
    line-height: 1;
  }
  .nexloyal-label {
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  #nexloyal-modal[aria-hidden="true"] {
    display: none;
  }
  #nexloyal-modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.35);
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    padding: 24px;
    z-index: 2147483646;
  }
  #nexloyal-panel {
    background: #0c1220;
    border-radius: 16px;
    max-width: 360px;
    width: min(92vw, 360px);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 24px 48px rgba(2, 6, 23, 0.45);
    display: flex;
    flex-direction: column;
    height: min(78vh, 640px);
    margin-left: auto;
  }
  #nexloyal-header {
    padding: 16px 20px;
    background: linear-gradient(135deg, #0b1224, #0f172a);
    color: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }
  .nexloyal-hero-title {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.8;
  }
  .nexloyal-hero-subtitle {
    font-size: 22px;
    font-weight: 700;
  }
  .nexloyal-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }
  .nexloyal-title {
    font-size: 18px;
    font-weight: 700;
  }
  #nexloyal-close {
    background: transparent;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: #e2e8f0;
  }
  #nexloyal-content {
    padding: 20px;
    overflow-y: auto;
    flex: 1 1 auto;
    color: #e2e8f0;
  }
  #nexloyal-content h3 {
    margin: 0 0 6px;
    font-size: 18px;
  }
  #nexloyal-content p {
    margin: 0 0 16px;
    color: #94a3b8;
  }
  .nexloyal-card {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    padding: 18px;
    background: #0f172a;
    box-shadow: 0 18px 30px rgba(2, 6, 23, 0.35);
    margin-bottom: 14px;
  }
  .nexloyal-card h4 {
    margin: 0 0 8px;
    font-size: 16px;
    color: #e2e8f0;
  }
  .nexloyal-card p {
    margin: 0 0 14px;
    color: #94a3b8;
  }
  .nexloyal-card .nexloyal-cta {
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: #04111f;
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
  }
  .nexloyal-link {
    display: inline-block;
    color: #38bdf8;
    text-decoration: underline;
    font-weight: 600;
    cursor: pointer;
  }
  .nexloyal-muted {
    color: #94a3b8;
    font-size: 13px;
    text-align: center;
  }
  .nexloyal-dashboard {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .nexloyal-welcome h2 {
    margin: 0 0 6px;
    font-size: 20px;
    color: #e2e8f0;
  }
  .nexloyal-welcome p {
    margin: 0;
    font-size: 13px;
    color: #94a3b8;
  }
  .nexloyal-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 12px;
    background: #0b1324;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 rgba(56, 189, 248, 0.08);
  }
  .nexloyal-stat {
    text-align: left;
  }
  .nexloyal-stat label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #94a3b8;
    margin-bottom: 6px;
  }
  .nexloyal-stat span {
    font-size: 22px;
    font-weight: 700;
    color: #e2e8f0;
  }
  .nexloyal-tier-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 0px;
    font-size: 12px;
    font-weight: 600;
    color: #7dd3fc;
  }
  .nexloyal-section-title {
    margin: 6px 0 0;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #94a3b8;
  }
  .nexloyal-list {
    display: grid;
    gap: 10px;
  }
  .nexloyal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 12px;
    padding: 12px 14px;
  }
  .nexloyal-row-title {
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
  }
  .nexloyal-row-sub {
    font-size: 12px;
    color: #94a3b8;
  }
  .nexloyal-row-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nexloyal-row-icon {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: #0b1324;
    display: grid;
    place-items: center;
    color: #38bdf8;
  }
  .nexloyal-row-icon svg,
  .nexloyal-row-chevron svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .nexloyal-row-chevron {
    width: 18px;
    height: 18px;
    color: #64748b;
  }
  .nexloyal-footer {
    background: #0b1324;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    padding: 14px 20px 18px;
  }
  .nexloyal-footer button {
    width: 100%;
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: #04111f;
    border: none;
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .nexloyal-form {
    display: grid;
    gap: 12px;
  }
  .nexloyal-form label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #94a3b8;
    margin-bottom: 6px;
    display: block;
  }
  .nexloyal-input {
    width: 100%;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: #0b1324;
    color: #e2e8f0;
    font-size: 13px;
  }
  .nexloyal-form-actions {
    display: flex;
    gap: 10px;
  }
  .nexloyal-secondary {
    background: transparent;
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }
  .nexloyal-action {
    background: transparent;
    color: #e2e8f0;
    border: 1px solid rgba(148, 163, 184, 0.3);
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 12px;
    cursor: pointer;
  }
  .nexloyal-badge {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 4px 8px;
    border-radius: 999px;
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #e2e8f0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 88px;
  }
  .nexloyal-badge.is-used {
    color: #fda4af;
    border-color: rgba(252, 165, 165, 0.45);
  }
  .nexloyal-badge.is-hold {
    color: #fde68a;
    border-color: rgba(251, 191, 36, 0.45);
  }
  .nexloyal-badge.is-unused {
    color: #bbf7d0;
    border-color: rgba(34, 197, 94, 0.45);
  }
  .nexloyal-row-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .nexloyal-row.is-disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
  .nexloyal-row.is-clickable {
    cursor: pointer;
  }
  .nexloyal-earn-card {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 12px;
    padding: 12px 14px;
    background: #0f172a;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .nexloyal-earn-left {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .nexloyal-earn-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 6px;
    text-align: right;
  }
  .nexloyal-earn-actions {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .nexloyal-earn-title {
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
  }
  .nexloyal-earn-meta {
    font-size: 12px;
    color: #94a3b8;
  }
  .nexloyal-earn-points {
    font-size: 11px;
    font-weight: 600;
    color: #93c5fd;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .nexloyal-earn-card.is-disabled {
    opacity: 0.5;
  }
  .nexloyal-earn-status {
    font-size: 10px;
    padding: 3px 6px;
    min-width: auto;
  }
  .nexloyal-wheel {
    border: 1px solid rgba(148, 163, 184, 0.25);
    border-radius: 14px;
    background: #0b1324;
    height: 180px;
    overflow: hidden;
    position: relative;
  }
  .nexloyal-wheel::after {
    content: "";
    position: absolute;
    left: 16px;
    right: 16px;
    top: 50%;
    height: 36px;
    transform: translateY(-50%);
    border: 1px solid rgba(56, 189, 248, 0.35);
    border-radius: 10px;
    pointer-events: none;
  }
  .nexloyal-wheel-list {
    transition: transform 2.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .nexloyal-wheel-item {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    color: #e2e8f0;
  }
  .nexloyal-wheel-note {
    font-size: 12px;
    color: #94a3b8;
    text-align: center;
  }
  .nexloyal-toast {
    position: absolute;
    bottom: 16px;
    left: 16px;
    right: 16px;
    background: rgba(15, 23, 42, 0.92);
    border: 1px solid rgba(148, 163, 184, 0.35);
    color: #e2e8f0;
    padding: 10px 12px;
    border-radius: 10px;
    font-size: 12px;
    z-index: 5;
  }
  .nexloyal-tabs {
    display: inline-flex;
    gap: 6px;
    background: #0b1324;
    border: 1px solid rgba(148, 163, 184, 0.18);
    padding: 4px;
    border-radius: 999px;
  }
  .nexloyal-tab {
    border: none;
    background: transparent;
    color: #94a3b8;
    font-size: 12px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
  }
  .nexloyal-tab.is-active {
    background: rgba(56, 189, 248, 0.15);
    color: #e2e8f0;
  }
  .nexloyal-activity-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }
  .nexloyal-activity-title {
    font-size: 13px;
    font-weight: 600;
    color: #e2e8f0;
  }
  .nexloyal-activity-meta {
    font-size: 11px;
    color: #94a3b8;
  }
  .nexloyal-activity-points {
    font-size: 12px;
    font-weight: 600;
  }
  .nexloyal-code {
    font-family: "Courier New", Courier, monospace;
    background: #0b1324;
    border: 1px dashed rgba(148, 163, 184, 0.35);
    color: #e2e8f0;
    padding: 10px 12px;
    border-radius: 10px;
    text-align: center;
    letter-spacing: 0.16em;
    font-weight: 700;
  }
  .nexloyal-chat-card {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    padding: 16px;
    background: #0f172a;
    display: grid;
    gap: 10px;
  }
  .nexloyal-chat-title {
    font-size: 15px;
    font-weight: 600;
    color: #e2e8f0;
  }
  .nexloyal-chat-body {
    font-size: 13px;
    color: #cbd5f5;
  }
  .nexloyal-chat-meta {
    font-size: 11px;
    color: #94a3b8;
  }
  .nexloyal-chat-images {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .nexloyal-chat-image {
    border-radius: 10px;
    width: 100%;
    height: 120px;
    object-fit: cover;
    cursor: pointer;
  }
  .nexloyal-poll-options {
    display: grid;
    gap: 8px;
  }
  .nexloyal-poll-option {
    border: 1px solid rgba(148, 163, 184, 0.3);
    border-radius: 10px;
    padding: 8px 12px;
    background: transparent;
    color: #e2e8f0;
    font-size: 13px;
    cursor: pointer;
    text-align: left;
  }
  .nexloyal-poll-option.is-selected {
    border-color: rgba(56, 189, 248, 0.7);
    background: rgba(56, 189, 248, 0.15);
    color: #e2e8f0;
  }
  .nexloyal-poll-option:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .nexloyal-lightbox {
    position: fixed;
    inset: 0;
    background: rgba(2, 6, 23, 0.78);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 2147483647;
    padding: 24px;
  }
  .nexloyal-lightbox.is-open {
    display: flex;
  }
  .nexloyal-lightbox img {
    max-width: min(92vw, 520px);
    max-height: 70vh;
    border-radius: 16px;
    border: 1px solid rgba(148, 163, 184, 0.3);
  }
  .nexloyal-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 180px;
    color: #e2e8f0;
  }
  .nexloyal-spinner {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid rgba(148, 163, 184, 0.35);
    border-top-color: #38bdf8;
    animation: nexloyal-spin 1s linear infinite;
  }
  @keyframes nexloyal-spin {
    to { transform: rotate(360deg); }
  }
  #nexloyal-content button:not(.nexloyal-secondary) {
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: #04111f;
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
  }
  #nexloyal-content button:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }
  .nexloyal-error {
    color: #fca5a5;
    font-size: 13px;
  }
  @media (max-width: 600px) {
    #nexloyal-widget {
      right: 16px;
      bottom: 16px;
    }
    #nexloyal-modal {
      padding: 12px;
      align-items: flex-end;
    }
    #nexloyal-panel {
      width: 100%;
      max-width: none;
      height: min(82vh, 620px);
      border-radius: 14px;
    }
    .nexloyal-earn-card {
      flex-direction: column;
      align-items: flex-start;
    }
    .nexloyal-earn-right {
      align-items: flex-start;
      text-align: left;
    }
  }
</style>

{% assign nexloyal_base_url = "https://nexloyal.store" %}
<script>
  (function() {
    var config = {
      customer: {{ customer | json }},
      customerId: {{ customer.id | json }},
      customerEmail: {{ customer.email | json }},
      shopDomain: "{{ shop.domain }}",
      loginUrl: "{{ routes.account_login_url }}",
      tokenUrl: "{{ nexloyal_base_url }}/loyalty/token",
      dataUrl: "{{ nexloyal_base_url }}/loyalty/data",
      couponsUrl: "{{ nexloyal_base_url }}/loyalty/coupons",
      myCouponsUrl: "{{ nexloyal_base_url }}/api/widget/my-coupons",
      earnRulesUrl: "{{ nexloyal_base_url }}/api/widget/earn/rules",
      earnStatusUrl: "{{ nexloyal_base_url }}/api/widget/earn/status",
      earnSocialUrl: "{{ nexloyal_base_url }}/api/widget/earn/social",
      mysteryBoxActiveUrl: "{{ nexloyal_base_url }}/api/widget/mystery-box/active",
      mysteryBoxClaimUrl: "{{ nexloyal_base_url }}/api/widget/mystery-box",
      chatMessagesUrl: "{{ nexloyal_base_url }}/api/widget/chat/messages",
      chatVoteUrl: "{{ nexloyal_base_url }}/api/widget/chat/polls",
      pointsHistoryUrl: "{{ nexloyal_base_url }}/api/widget/points/history"
    };

    var trigger = document.getElementById('nexloyal-trigger');
    var modal = document.getElementById('nexloyal-modal');
    var closeButton = document.getElementById('nexloyal-close');
    var content = document.getElementById('nexloyal-content');

    function openModal() {
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeModal() {
      modal.setAttribute('aria-hidden', 'true');
    }

    function renderLoggedOut() {
      content.innerHTML = '' +
        '<div class="nexloyal-card">' +
          '<h4>Become a member</h4>' +
          '<p>Unlock exclusive rewards and start earning points today.</p>' +
          '<button id="nexloyal-join" class="nexloyal-cta">Join now</button>' +
          '<p class="nexloyal-muted" style="margin-top:10px;">Already have an account? <span id="nexloyal-login" class="nexloyal-link">Sign in</span></p>' +
        '</div>' +
        '<div class="nexloyal-card">' +
          '<h4>Rewards Points</h4>' +
          '<p>Earn points for purchases and redeem them for perks.</p>' +
          '<div class="nexloyal-muted">Powered by NexLoyal</div>' +
        '</div>';

      function goToLogin() {
        var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
        window.location.href = config.loginUrl + '?return_url=' + returnUrl;
      }

      document.getElementById('nexloyal-join').addEventListener('click', goToLogin);
      document.getElementById('nexloyal-login').addEventListener('click', goToLogin);
    }

    function renderDashboard(data, status) {
      var tierLabel = data.tier ? data.tier : 'No tier yet';
      var displayName = data.name ? data.name : (data.email || 'Customer');
      var availablePoints = status && typeof status.points_available === 'number'
        ? status.points_available
        : (data.points || 0);
      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>Welcome back!</h2>' +
            '<p>' + displayName + '</p>' +
          '</div>' +
          '<div class="nexloyal-stats">' +
            '<div class="nexloyal-stat">' +
              '<label>Points</label>' +
              '<span>' + availablePoints + '</span>' +
            '</div>' +
            '<div class="nexloyal-stat">' +
              '<label>Tier</label>' +
              '<span class="nexloyal-tier-badge">' + tierLabel + '</span>' +
            '</div>' +
          '</div>' +
          '<div class="nexloyal-section-title">Your Loyalty Hub</div>' +
          '<div class="nexloyal-list">' +
            '<div class="nexloyal-row" data-action="profile">' +
              '<div class="nexloyal-row-left">' +
            '<div class="nexloyal-row-icon">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                '<path d="M20 21a8 8 0 0 0-16 0"></path>' +
                '<circle cx="12" cy="7" r="4"></circle>' +
              '</svg>' +
            '</div>' +
                '<div>' +
                  '<div class="nexloyal-row-title">Complete your profile</div>' +
                  '<div class="nexloyal-row-sub">Unlock profile rewards</div>' +
                '</div>' +
              '</div>' +
            '<div class="nexloyal-row-chevron">' +
              '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
                '<path d="M9 18l6-6-6-6"></path>' +
              '</svg>' +
            '</div>' +
            '</div>' +
            '<div class="nexloyal-row" data-action="redeem">' +
