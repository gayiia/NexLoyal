                '<p>Complete actions to grow your balance.</p>' +
              '</div>' +
              '<div class="nexloyal-card">' +
                '<h4>General rewards</h4>' +
                earningRate +
                '<div class="nexloyal-list">' + generalRows + '</div>' +
              '</div>' +
              '<div class="nexloyal-card">' +
                '<h4>Social rewards</h4>' +
                (socialRows ? '<div class="nexloyal-list">' + socialRows + '</div>' : '<div class="nexloyal-muted">No social rewards configured.</div>') +
              '</div>' +
              '<div class="nexloyal-form-actions">' +
                '<button type="button" id="nexloyal-earn-back" class="nexloyal-secondary">Back</button>' +
              '</div>' +
            '</div>';

          var backButton = document.getElementById('nexloyal-earn-back');
          if (backButton) {
            backButton.addEventListener('click', function () {
              loadDashboard(config.currentToken);
            });
          }

          var profileButton = document.getElementById('nexloyal-earn-profile');
          if (profileButton) {
            profileButton.addEventListener('click', function () {
              renderProfileForm();
            });
          }

          content.querySelectorAll('[data-social-platform]').forEach(function (row) {
            var button = row.querySelector('button');
            if (!button) {
              return;
            }
            button.addEventListener('click', function () {
              var platform = row.getAttribute('data-social-platform');
              var url = row.getAttribute('data-social-url');
              postEarnSocial(platform)
                .then(function(response) {
                  if (!response || response._ok === false) {
                    showToast((response && response.message) ? response.message : 'Unable to claim right now');
                    if (url) {
                      window.open(url, '_blank', 'noopener');
                    }
                    return;
                  }

                  var awarded = response && response.awarded === true;
                  var already = response && response.awarded === false;

                  if (awarded) {
                    showToast('+' + (social[platform].points || 0) + ' points earned');
                  } else if (already) {
                    showToast('Already claimed');
                  } else {
                    showToast((response && response.message) ? response.message : 'Unable to claim right now');
                  }

                  if (awarded || already) {
                    row.classList.add('is-disabled');
                    row.querySelector('.nexloyal-earn-right').innerHTML =
                      '<div class="nexloyal-earn-points">+' + (social[platform].points || 0) + ' points</div>' +
                      '<span class="nexloyal-earn-status nexloyal-badge is-used">Completed</span>';
                  }

                  if (url) {
                    window.open(url, '_blank', 'noopener');
                  }
                })
                .catch(function() {
                  showToast('Unable to claim right now');
                  if (url) {
                    window.open(url, '_blank', 'noopener');
                  }
                });
            });
          });
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to load earn options right now. Please try again.</p>';
        });
    }

    function renderMysteryBox() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-loading">' +
          '<div class="nexloyal-spinner" aria-label="Loading"></div>' +
        '</div>';

      fetch(getMysteryBoxActiveUrl(), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(payload) {
          var box = payload && payload.box ? payload.box : null;
          var wheelItems = payload && Array.isArray(payload.wheel_items) ? payload.wheel_items : [];

          if (!box) {
            content.innerHTML = '' +
              '<div class="nexloyal-dashboard">' +
                '<div class="nexloyal-welcome">' +
                  '<h2>Mystery Box</h2>' +
                  '<p>No active rewards are available right now.</p>' +
                '</div>' +
                '<div class="nexloyal-form-actions">' +
                  '<button type="button" id="nexloyal-mystery-back" class="nexloyal-secondary">Back</button>' +
                '</div>' +
              '</div>';
            document.getElementById('nexloyal-mystery-back').addEventListener('click', function () {
              loadDashboard(config.currentToken);
            });
            return;
          }

          var canClaim = !!box.can_claim;
          var nextClaim = box.next_claim_at ? new Date(box.next_claim_at) : null;
          var nextLabel = nextClaim && !isNaN(nextClaim.getTime())
            ? nextClaim.toISOString().slice(0, 10)
            : '';

          content.innerHTML = '' +
            '<div class="nexloyal-dashboard">' +
              '<div class="nexloyal-welcome">' +
                '<h2>Mystery Box</h2>' +
                '<p>Spin the wheel to reveal your reward.</p>' +
              '</div>' +
              '<div class="nexloyal-card">' +
                '<p class="nexloyal-muted" style="text-align:left;">Try your luck and unlock a surprise reward.</p>' +
                '<div class="nexloyal-wheel-note">Your reward will be added to My Coupons.</div>' +
              '</div>' +
              '<div class="nexloyal-form-actions">' +
                '<button type="button" id="nexloyal-mystery-claim"' + (canClaim ? '' : ' disabled') + '>Claim reward</button>' +
                '<button type="button" id="nexloyal-mystery-back" class="nexloyal-secondary">Back</button>' +
              '</div>' +
              (canClaim ? '' : '<div class="nexloyal-muted">Already claimed' + (nextLabel ? '. Try again on ' + nextLabel : '') + '.</div>') +
            '</div>';

          document.getElementById('nexloyal-mystery-back').addEventListener('click', function () {
            loadDashboard(config.currentToken);
          });

          var claimButton = document.getElementById('nexloyal-mystery-claim');
          if (!claimButton) {
            return;
          }

          claimButton.addEventListener('click', function () {
            if (claimButton.disabled) {
              return;
            }

            claimButton.disabled = true;
            claimButton.textContent = 'Spinning...';

            fetch(getMysteryBoxClaimUrl(box.id), { method: 'POST', mode: 'cors' })
              .then(function(response) { return response.json(); })
              .then(function(result) {
                if (!result || !result.won) {
                  throw new Error((result && result.message) ? result.message : 'Unable to claim right now');
                }

                var won = result.won;
                var listItems = Array.isArray(result.wheel_items) ? result.wheel_items : wheelItems;
                var titles = listItems.map(function (item) { return item.title; }).filter(Boolean);
                if (!titles.length) {
                  titles = [won.title || 'Reward'];
                }

                var repeats = 4;
                var itemsHtml = '';
                for (var i = 0; i < repeats; i++) {
                  titles.forEach(function (title) {
                    itemsHtml += '<div class="nexloyal-wheel-item">' + title + '</div>';
                  });
                }

                content.innerHTML = '' +
                  '<div class="nexloyal-dashboard">' +
                    '<div class="nexloyal-welcome">' +
                      '<h2>Mystery Box</h2>' +
                      '<p>And the wheel stops at...</p>' +
                    '</div>' +
                    '<div class="nexloyal-card">' +
                      '<div class="nexloyal-wheel">' +
                        '<div id="nexloyal-wheel-list" class="nexloyal-wheel-list">' +
                          itemsHtml +
                        '</div>' +
                      '</div>' +
                    '</div>' +
                    '<div id="nexloyal-wheel-result"></div>' +
                    '<div class="nexloyal-form-actions">' +
                      '<button type="button" id="nexloyal-mystery-back" class="nexloyal-secondary">Back</button>' +
                    '</div>' +
                  '</div>';

                var wheelList = document.getElementById('nexloyal-wheel-list');
                var itemHeight = 36;
                var baseIndex = titles.indexOf(won.title);
                if (baseIndex < 0) {
                  baseIndex = 0;
                }
                var targetIndex = baseIndex + (titles.length * 2);

                setTimeout(function () {
                  if (wheelList) {
                    wheelList.style.transform = 'translateY(' + (-targetIndex * itemHeight) + 'px)';
                  }
                }, 60);

                setTimeout(function () {
                  var resultEl = document.getElementById('nexloyal-wheel-result');
                  if (!resultEl) {
                    return;
                  }
                  resultEl.innerHTML = '' +
                    '<div class="nexloyal-card">' +
                      '<h4>You won: ' + (won.title || 'Reward') + '</h4>' +
                      '<div class="nexloyal-code">' + won.code + '</div>' +
                      '<div class="nexloyal-form-actions" style="margin-top:12px;">' +
                        '<button type="button" id="nexloyal-mystery-copy">Copy code</button>' +
                        '<button type="button" id="nexloyal-mystery-view" class="nexloyal-secondary">View in My Coupons</button>' +
                      '</div>' +
                    '</div>';

                  var copyButton = document.getElementById('nexloyal-mystery-copy');
                  if (copyButton) {
                    copyButton.addEventListener('click', function () {
                      copyToClipboard(won.code, copyButton);
                    });
                  }
                  var viewButton = document.getElementById('nexloyal-mystery-view');
                  if (viewButton) {
                    viewButton.addEventListener('click', function () {
                      renderMyCouponsList();
                    });
                  }
                }, 2700);

                document.getElementById('nexloyal-mystery-back').addEventListener('click', function () {
                  loadDashboard(config.currentToken);
                });
              })
              .catch(function(error) {
                showToast(error.message || 'Unable to claim right now');
                claimButton.disabled = false;
                claimButton.textContent = 'Claim reward';
              });
          });
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to load Mystery Box right now. Please try again.</p>';
        });
    }

    function renderChat() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-loading">' +
          '<div class="nexloyal-spinner" aria-label="Loading"></div>' +
        '</div>';

      fetch(getChatMessagesUrl(), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(payload) {
          var meta = payload && payload.meta ? payload.meta : {};
          if (meta.enabled === false || meta.allowed === false) {
            content.innerHTML = '' +
              '<div class="nexloyal-dashboard">' +
                '<div class="nexloyal-welcome">' +
                  '<h2>Exclusive Chat</h2>' +
                  '<p>This channel is available to select tiers only.</p>' +
                '</div>' +
                '<div class="nexloyal-form-actions">' +
                  '<button type="button" id="nexloyal-chat-back" class="nexloyal-secondary">Back</button>' +
                '</div>' +
              '</div>';
            document.getElementById('nexloyal-chat-back').addEventListener('click', function () {
              loadDashboard(config.currentToken);
            });
            return;
          }

          var messages = payload && Array.isArray(payload.data) ? payload.data : [];
          if (!messages.length) {
            content.innerHTML = '' +
              '<div class="nexloyal-dashboard">' +
                '<div class="nexloyal-welcome">' +
                  '<h2>Exclusive Chat</h2>' +
                  '<p>No updates yet. Check back soon.</p>' +
                '</div>' +
                '<div class="nexloyal-form-actions">' +
                  '<button type="button" id="nexloyal-chat-back" class="nexloyal-secondary">Back</button>' +
                '</div>' +
              '</div>';
            document.getElementById('nexloyal-chat-back').addEventListener('click', function () {
              loadDashboard(config.currentToken);
            });
            return;
          }

          var cards = messages.map(function (message) {
            var sentAt = message.sent_at ? new Date(message.sent_at) : null;
            var sentLabel = sentAt && !isNaN(sentAt.getTime()) ? sentAt.toISOString().replace('T', ' ').slice(0, 16) : '';
            var images = Array.isArray(message.attachments) ? message.attachments.filter(function (item) { return item.url; }) : [];
            var imagesHtml = images.length
              ? '<div class="nexloyal-chat-images">' +
                  images.map(function (item) {
                    return '<img class="nexloyal-chat-image" src="' + item.url + '" data-chat-image="' + item.url + '" alt="Chat image">';
                  }).join('') +
                '</div>'
              : '';

            var pollHtml = '';
            if (message.poll && message.poll.options) {
              var poll = message.poll;
              var closed = poll.closes_at ? (new Date(poll.closes_at) < new Date()) : false;
              var myVote = poll.my_vote_option_id;
              var myVoteLabel = '';
              if (myVote) {
                poll.options.forEach(function (option) {
                  if (option.id === myVote) {
                    myVoteLabel = option.label;
                  }
                });
              }
              var statusLabel = closed
                ? 'Poll closed'
                : (myVote ? ('You voted: ' + myVoteLabel) : 'Cast your vote');

              var optionsHtml = poll.options.map(function (option) {
                var isSelected = myVote && option.id === myVote;
                var disabled = myVote || closed;
                return '' +
                  '<button type="button" class="nexloyal-poll-option' + (isSelected ? ' is-selected' : '') + '"' +
                    ' data-poll-id="' + poll.poll_id + '"' +
                    ' data-option-id="' + option.id + '"' +
                    (disabled ? ' disabled' : '') +
                  '>' + option.label + '</button>';
              }).join('');

              pollHtml = '' +
                '<div class="nexloyal-chat-meta" data-poll-status="' + poll.poll_id + '">' + statusLabel + '</div>' +
                '<div class="nexloyal-poll-options" data-poll-container="' + poll.poll_id + '">' + optionsHtml + '</div>';
            }

            return '' +
              '<div class="nexloyal-chat-card">' +
                (message.title ? '<div class="nexloyal-chat-title">' + message.title + '</div>' : '') +
                '<div class="nexloyal-chat-body">' + (message.body || '') + '</div>' +
                imagesHtml +
                pollHtml +
                (sentLabel ? '<div class="nexloyal-chat-meta">' + sentLabel + '</div>' : '') +
              '</div>';
          }).join('');

          content.innerHTML = '' +
            '<div class="nexloyal-dashboard">' +
              '<div class="nexloyal-welcome">' +
                '<h2>Exclusive Chat</h2>' +
                '<p>Updates from the store team.</p>' +
              '</div>' +
              '<div class="nexloyal-list">' + cards + '</div>' +
              '<div class="nexloyal-form-actions">' +
                '<button type="button" id="nexloyal-chat-back" class="nexloyal-secondary">Back</button>' +
              '</div>' +
            '</div>' +
            '<div id="nexloyal-lightbox" class="nexloyal-lightbox" aria-hidden="true">' +
              '<img id="nexloyal-lightbox-img" alt="Preview">' +
            '</div>';

          document.getElementById('nexloyal-chat-back').addEventListener('click', function () {
            loadDashboard(config.currentToken);
          });

          var lightbox = document.getElementById('nexloyal-lightbox');
          var lightboxImg = document.getElementById('nexloyal-lightbox-img');
          if (lightbox && lightboxImg) {
            content.querySelectorAll('[data-chat-image]').forEach(function (img) {
              img.addEventListener('click', function () {
                var url = img.getAttribute('data-chat-image');
                if (url) {
                  lightboxImg.src = url;
                  lightbox.classList.add('is-open');
                  lightbox.setAttribute('aria-hidden', 'false');
                }
              });
            });

            lightbox.addEventListener('click', function () {
              lightbox.classList.remove('is-open');
              lightbox.setAttribute('aria-hidden', 'true');
            });
          }

          content.querySelectorAll('[data-poll-id][data-option-id]').forEach(function (button) {
            if (button.disabled) {
              return;
            }
            button.addEventListener('click', function () {
              var pollId = button.getAttribute('data-poll-id');
              var optionId = button.getAttribute('data-option-id');
              if (!pollId || !optionId) {
                return;
              }

              fetch(getChatVoteUrl(pollId), {
                method: 'POST',
                mode: 'cors',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ option_id: Number(optionId) })
              })
                .then(function(response) { return response.json(); })
                .then(function(result) {
                  if (!result || !result.success) {
                    showToast((result && result.message) ? result.message : 'Unable to vote right now');
                    return;
                  }

                  var container = content.querySelector('[data-poll-container="' + pollId + '"]');
                  var status = content.querySelector('[data-poll-status="' + pollId + '"]');
                  if (container) {
                    container.querySelectorAll('button').forEach(function (optionButton) {
                      optionButton.disabled = true;
                      if (optionButton.getAttribute('data-option-id') === String(result.my_vote_option_id)) {
                        optionButton.classList.add('is-selected');
                        if (status) {
                          status.textContent = 'You voted: ' + optionButton.textContent;
                        }
                      }
                    });
                  }
                })
                .catch(function() {
                  showToast('Unable to vote right now');
                });
            });
          });
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to load chat right now. Please try again.</p>';
        });
    }

    function renderActivity(filter) {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      var activeFilter = filter || 'earned';
      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>Activity</h2>' +
            '<p>Your points balance may not reflect your latest activity.</p>' +
          '</div>' +
          '<div class="nexloyal-tabs" role="tablist">' +
            '<button type="button" class="nexloyal-tab' + (activeFilter === 'earned' ? ' is-active' : '') + '" data-activity-tab="earned">Earned</button>' +
            '<button type="button" class="nexloyal-tab' + (activeFilter === 'redeemed' ? ' is-active' : '') + '" data-activity-tab="redeemed">Redeemed</button>' +
          '</div>' +
          '<div id="nexloyal-activity-list" class="nexloyal-list"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-activity-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-activity-back').addEventListener('click', function () {
        loadDashboard(config.currentToken);
      });

      var listEl = document.getElementById('nexloyal-activity-list');
      listEl.innerHTML = '<div class="nexloyal-loading"><div class="nexloyal-spinner" aria-label="Loading"></div></div>';

      content.querySelectorAll('[data-activity-tab]').forEach(function (tab) {
        tab.addEventListener('click', function () {
          var next = tab.getAttribute('data-activity-tab');
          renderActivity(next);
        });
      });

      fetch(getPointsHistoryUrl(activeFilter), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(payload) {
          if (!payload || !Array.isArray(payload.data)) {
            throw new Error('History missing');
          }

          if (!payload.data.length) {
            listEl.innerHTML = '<div class="nexloyal-muted">No activity yet.</div>';
            return;
          }

          var rows = payload.data.map(function (item) {
            var isEarn = item.direction === 'EARN';
            var pointsLabel = (isEarn ? '+ ' : '- ') + item.points + ' points';
            var pointsClass = isEarn ? 'nexloyal-activity-points' : 'nexloyal-activity-points';
            var statusChip = '';
            if (item.status === 'PENDING') {
              statusChip = '<span class="nexloyal-badge">In progress</span>';
            } else if (item.status === 'REVERSED') {
              statusChip = '<span class="nexloyal-badge">Reversed</span>';
            }
            var created = item.created_at ? new Date(item.created_at) : null;
            var dateLabel = created && !isNaN(created.getTime()) ? created.toISOString().replace('T', ' ').slice(0, 19) : '';

            return '' +
              '<div class="nexloyal-earn-card">' +
                '<div class="nexloyal-earn-left">' +
                  '<div class="nexloyal-activity-title">' + item.title + '</div>' +
                  '<div class="nexloyal-activity-meta">' + dateLabel + '</div>' +
                  '<div class="' + pointsClass + '" style="color:' + (isEarn ? '#86efac' : '#fda4af') + ';">' + pointsLabel + '</div>' +
                '</div>' +
                '<div class="nexloyal-row-actions">' +
                  statusChip +
                '</div>' +
              '</div>';
          }).join('');

          listEl.innerHTML = rows;
        })
        .catch(function() {
          listEl.innerHTML = '<div class="nexloyal-error">Unable to load activity right now. Please try again.</div>';
        });
    }

    function renderMyCouponsList() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>My coupons</h2>' +
            '<p>Your redeemed rewards.</p>' +
          '</div>' +
          '<div id="nexloyal-my-coupon-list" class="nexloyal-list"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-my-coupon-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-my-coupon-back').addEventListener('click', function () {
        loadDashboard(config.currentToken);
      });

      var listEl = document.getElementById('nexloyal-my-coupon-list');
      listEl.innerHTML = '<div class="nexloyal-loading"><div class="nexloyal-spinner" aria-label="Loading"></div></div>';

      fetch(getMyCouponsUrl(), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || !Array.isArray(data.coupons)) {
            throw new Error('My coupon data missing');
          }

          if (!data.coupons.length) {
            listEl.innerHTML = '<div class="nexloyal-muted">No redeemed coupons yet.</div>';
            return;
          }

          var couponIndex = {};
          var rows = data.coupons.map(function (coupon) {
            couponIndex[coupon.redemption_id || coupon.id] = coupon;
            var statusLabel = formatStatusLabel(coupon.status);
            var statusClass = statusClassFromLabel(statusLabel);
            var codeLabel = maskCode(coupon.shopify_discount_code || coupon.code);
            var expiryLabel = formatDateLabel(coupon.expires_at);
            var titleLabel = coupon.coupon_title || coupon.title || 'Coupon';
            var valueLabel = coupon.coupon_value_label || (typeof coupon.coupon_points === 'number' ? (coupon.coupon_points + ' points') : 'Value unavailable');
            var isHold = statusLabel === 'On hold';
            var rowClass = isHold ? 'nexloyal-row is-disabled' : 'nexloyal-row is-clickable';
            return '' +
              '<div class="' + rowClass + '" data-coupon-id="' + (coupon.redemption_id || coupon.id) + '" data-coupon-status="' + statusLabel + '">' +
                '<div>' +
                  '<div class="nexloyal-row-title">' + titleLabel + '</div>' +
                  '<div class="nexloyal-row-sub">' + valueLabel + ' | ' + codeLabel + ' | ' + expiryLabel + '</div>' +
                '</div>' +
                '<div class="nexloyal-row-actions">' +
                  '<span class="' + statusClass + '">' + statusLabel + '</span>' +
                '</div>' +
              '</div>';
          }).join('');

          config.myCouponIndex = couponIndex;
          listEl.innerHTML = rows;

          listEl.querySelectorAll('[data-coupon-id]').forEach(function (row) {
            row.addEventListener('click', function () {
              var statusLabel = row.getAttribute('data-coupon-status');
              if (statusLabel === 'On hold') {
                return;
              }
              var couponId = row.getAttribute('data-coupon-id');
              fetch(getMyCouponDetailUrl(couponId), { method: 'GET', mode: 'cors' })
                .then(function(response) { return response.json(); })
                .then(function(payload) {
                  var coupon = payload && payload.coupon ? payload.coupon : (config.myCouponIndex ? config.myCouponIndex[couponId] : null);
                  renderMyCouponDetail(coupon);
                })
                .catch(function() {
                  renderMyCouponDetail(config.myCouponIndex ? config.myCouponIndex[couponId] : null);
                });
            });
          });
        })
        .catch(function() {
          listEl.innerHTML = '<div class="nexloyal-error">Unable to load coupons right now. Please try again.</div>';
        });
    }

    function renderMyCouponDetail(coupon) {
      if (!coupon) {
        renderMyCouponsList();
        return;
      }

      var statusLabel = formatStatusLabel(coupon.status);
      var statusClass = statusClassFromLabel(statusLabel);
      var codeLabel = coupon.shopify_discount_code || coupon.code || 'Code unavailable';
      var expiryLabel = formatDateLabel(coupon.expires_at);
      var titleLabel = coupon.coupon_title || coupon.title || 'Coupon';
      var valueLabel = coupon.coupon_value_label || (typeof coupon.coupon_points === 'number' ? (coupon.coupon_points + ' points') : 'Value unavailable');

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>' + titleLabel + '</h2>' +
            '<p>Value: ' + valueLabel + '. Valid until ' + expiryLabel + '.</p>' +
          '</div>' +
          '<div class="nexloyal-card">' +
            '<div class="' + statusClass + '">' + statusLabel + '</div>' +
            '<div class="nexloyal-code" style="margin-top:12px;">' + codeLabel + '</div>' +
          '</div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-copy-code"' + ((coupon.shopify_discount_code || coupon.code) ? '' : ' disabled') + '>Copy code</button>' +
            '<button type="button" id="nexloyal-my-coupon-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-my-coupon-back').addEventListener('click', function () {
        renderMyCouponsList();
      });

      var copyButton = document.getElementById('nexloyal-copy-code');
      if (copyButton) {
        copyButton.addEventListener('click', function () {
          copyToClipboard(coupon.shopify_discount_code || coupon.code, copyButton);
        });
      }
    }

    function renderCouponsList() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>Redeem points</h2>' +
            '<p>Choose a reward to spend your points.</p>' +
          '</div>' +
          '<div class="nexloyal-muted">You have <span id="nexloyal-coupon-points">0</span> points.</div>' +
          '<div id="nexloyal-coupon-list" class="nexloyal-list"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-coupon-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-coupon-back').addEventListener('click', function () {
        loadDashboard(config.currentToken);
      });

      var listEl = document.getElementById('nexloyal-coupon-list');
      listEl.innerHTML = '<div class="nexloyal-loading"><div class="nexloyal-spinner" aria-label="Loading"></div></div>';

      fetch(getCouponsUrl(), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || !Array.isArray(data.coupons)) {
            throw new Error('Coupon data missing');
          }

          config.currentPoints = data.points || 0;
          var pointsEl = document.getElementById('nexloyal-coupon-points');
          if (pointsEl) {
            pointsEl.textContent = config.currentPoints;
          }

          if (!data.coupons.length) {
            listEl.innerHTML = '<div class="nexloyal-muted">No coupons available for your tier right now.</div>';
            return;
          }

          var couponIndex = {};
          var rows = data.coupons.map(function (coupon) {
            couponIndex[coupon.id] = coupon;
            return '' +
              '<div class="nexloyal-row" data-coupon-id="' + coupon.id + '">' +
                '<div>' +
                  '<div class="nexloyal-row-title">' + coupon.title + '</div>' +
                  '<div class="nexloyal-row-sub">' + coupon.points_value + ' points</div>' +
                '</div>' +
                '<div class="nexloyal-row-actions">' +
                  '<button type="button" class="nexloyal-action" data-view-coupon="' + coupon.id + '">View</button>' +
                '</div>' +
              '</div>';
          }).join('');

          config.couponIndex = couponIndex;
          listEl.innerHTML = rows;

          listEl.querySelectorAll('[data-view-coupon]').forEach(function (button) {
            button.addEventListener('click', function () {
              var couponId = button.getAttribute('data-view-coupon');
              renderCouponDetail(config.couponIndex ? config.couponIndex[couponId] : null);
            });
          });
        })
        .catch(function() {
          listEl.innerHTML = '<div class="nexloyal-error">Unable to load coupons right now. Please try again.</div>';
        });
    }

    function renderCouponDetail(coupon) {
      if (!coupon) {
        renderCouponsList();
        return;
      }

      var pointsCost = coupon.points_value || 0;
      var remainingPoints = typeof config.currentPoints === 'number' ? config.currentPoints : 0;
      var canRedeem = remainingPoints >= pointsCost;

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>' + coupon.title + '</h2>' +
            '<p>Redeem for ' + pointsCost + ' points.</p>' +
          '</div>' +
          '<div class="nexloyal-card">' +
            '<h4>About this coupon</h4>' +
            '<p>' + (coupon.description || 'No description available.') + '</p>' +
            '<div class="nexloyal-muted">You have ' + remainingPoints + ' points.</div>' +
          '</div>' +
          '<div id="nexloyal-redeem-error" class="nexloyal-error"></div>' +
          '<div class="nexloyal-form-actions">' +
            '<button type="button" id="nexloyal-redeem-button"' + (canRedeem ? '' : ' disabled') + '>Redeem for ' + pointsCost + ' points</button>' +
            '<button type="button" id="nexloyal-redeem-back" class="nexloyal-secondary">Back</button>' +
          '</div>' +
        '</div>';

      document.getElementById('nexloyal-redeem-back').addEventListener('click', function () {
        renderCouponsList();
      });

      var redeemButton = document.getElementById('nexloyal-redeem-button');
      redeemButton.addEventListener('click', function () {
        if (redeemButton.disabled) {
          return;
        }

        redeemButton.disabled = true;
        redeemButton.textContent = 'Redeeming...';

        fetch(getRedeemUrl(coupon.id), { method: 'POST', mode: 'cors' })
          .then(function(response) { return response.json(); })
          .then(function(data) {
            if (!data || !data.code) {
              throw new Error((data && data.message) || 'Redeem failed');
            }

            config.currentPoints = data.points || 0;
            content.innerHTML = '' +
              '<div class="nexloyal-dashboard">' +
                '<div class="nexloyal-welcome">' +
                  '<h2>Coupon unlocked</h2>' +
                  '<p>Use this code at checkout.</p>' +
                '</div>' +
                '<div class="nexloyal-card">' +
                  '<h4>' + coupon.title + '</h4>' +
                  '<div class="nexloyal-code">' + data.code + '</div>' +
                  '<p class="nexloyal-muted" style="margin-top:12px;">Remaining points: ' + config.currentPoints + '</p>' +
                '</div>' +
                '<div class="nexloyal-form-actions">' +
                  '<button type="button" id="nexloyal-coupon-more">View more coupons</button>' +
                  '<button type="button" id="nexloyal-coupon-done" class="nexloyal-secondary">Back to rewards</button>' +
                '</div>' +
              '</div>';

            document.getElementById('nexloyal-coupon-more').addEventListener('click', function () {
              renderCouponsList();
            });
            document.getElementById('nexloyal-coupon-done').addEventListener('click', function () {
              loadDashboard(config.currentToken);
            });
          })
          .catch(function(error) {
            var errorEl = document.getElementById('nexloyal-redeem-error');
            if (errorEl) {
              errorEl.textContent = error.message || 'Unable to redeem this coupon. Please try again.';
            }
            redeemButton.disabled = false;
            redeemButton.textContent = 'Redeem for ' + pointsCost + ' points';
          });
      });
    }

    trigger.addEventListener('click', function() {
      openModal();
      if (!config.customerId || !config.customerEmail) {
        renderLoggedOut();
        return;
      }
      renderLoggedIn(config.customer);
    });

    closeButton.addEventListener('click', closeModal);
    modal.addEventListener('click', function(event) {
      if (event.target === modal) {
        closeModal();
      }
    });
  })();
</script>
