<!-- Nexloyal floating widget (paste before </body> in theme.liquid) -->
<div id="nexloyal-widget">
  <button id="nexloyal-trigger" type="button" aria-haspopup="dialog" aria-controls="nexloyal-modal" aria-label="Open rewards">
    <span class="nexloyal-icon">★</span>
    <span class="nexloyal-label">Rewards</span>
  </button>
  <div id="nexloyal-modal" role="dialog" aria-modal="true" aria-hidden="true">
    <div id="nexloyal-panel">
      <div id="nexloyal-header">
        <div>
          <div class="nexloyal-eyebrow">Rewards</div>
          <div class="nexloyal-title">NexLoyal</div>
        </div>
        <button id="nexloyal-close" type="button" aria-label="Close">&times;</button>
      </div>
      <div id="nexloyal-content"></div>
    </div>
  </div>
</div>

<style>
  #nexloyal-widget {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 2147483647;
    font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
  }
  #nexloyal-trigger {
    background: #111827;
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 10px 16px;
    height: 48px;
    border-radius: 999px;
    font-size: 14px;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 16px 32px rgba(15, 23, 42, 0.2);
  }
  .nexloyal-icon {
    width: 28px;
    height: 28px;
    border-radius: 999px;
    background: radial-gradient(circle at top, #fbbf24, #f97316);
    display: grid;
    place-items: center;
    font-size: 14px;
    color: #111827;
    line-height: 1;
  }
  .nexloyal-label {
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  #nexloyal-modal[aria-hidden="true"] {
    display: none;
  }
  #nexloyal-modal {
    position: fixed;
    inset: 0;
    background: rgba(15, 23, 42, 0.35);
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    padding: 24px;
    z-index: 2147483646;
  }
  #nexloyal-panel {
    background: #0c1220;
    border-radius: 16px;
    max-width: 360px;
    width: min(92vw, 360px);
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(148, 163, 184, 0.18);
    box-shadow: 0 24px 48px rgba(2, 6, 23, 0.45);
    display: flex;
    flex-direction: column;
    height: min(78vh, 640px);
    margin-left: auto;
  }
  #nexloyal-header {
    padding: 16px 20px;
    background: linear-gradient(135deg, #0b1224, #0f172a);
    color: #e2e8f0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(148, 163, 184, 0.2);
  }
  .nexloyal-hero-title {
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    opacity: 0.8;
  }
  .nexloyal-hero-subtitle {
    font-size: 22px;
    font-weight: 700;
  }
  .nexloyal-eyebrow {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }
  .nexloyal-title {
    font-size: 18px;
    font-weight: 700;
  }
  #nexloyal-close {
    background: transparent;
    border: none;
    font-size: 26px;
    cursor: pointer;
    color: #e2e8f0;
  }
  #nexloyal-content {
    padding: 20px;
    overflow-y: auto;
    flex: 1 1 auto;
    color: #e2e8f0;
  }
  #nexloyal-content h3 {
    margin: 0 0 6px;
    font-size: 18px;
  }
  #nexloyal-content p {
    margin: 0 0 16px;
    color: #94a3b8;
  }
  .nexloyal-card {
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    padding: 18px;
    background: #0f172a;
    box-shadow: 0 18px 30px rgba(2, 6, 23, 0.35);
    margin-bottom: 14px;
  }
  .nexloyal-card h4 {
    margin: 0 0 8px;
    font-size: 16px;
  }
  .nexloyal-card p {
    margin: 0 0 14px;
    color: #94a3b8;
  }
  .nexloyal-card .nexloyal-cta {
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: #04111f;
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
  }
  .nexloyal-link {
    display: inline-block;
    color: #38bdf8;
    text-decoration: underline;
    font-weight: 600;
    cursor: pointer;
  }
  .nexloyal-muted {
    color: #94a3b8;
    font-size: 13px;
    text-align: center;
  }
  .nexloyal-dashboard {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .nexloyal-welcome h2 {
    margin: 0 0 6px;
    font-size: 20px;
    color: #e2e8f0;
  }
  .nexloyal-welcome p {
    margin: 0;
    font-size: 13px;
    color: #94a3b8;
  }
  .nexloyal-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    padding: 12px;
    background: #0b1324;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 14px;
    box-shadow: inset 0 1px 0 rgba(56, 189, 248, 0.08);
  }
  .nexloyal-stat {
    text-align: left;
  }
  .nexloyal-stat label {
    display: block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #94a3b8;
    margin-bottom: 6px;
  }
  .nexloyal-stat span {
    font-size: 22px;
    font-weight: 700;
    color: #e2e8f0;
  }
  .nexloyal-tier-badge {
    display: inline-flex;
    align-items: center;
    padding: 4px 0px;
    font-size: 12px;
    font-weight: 600;
    color: #7dd3fc;
  }
  .nexloyal-section-title {
    margin: 6px 0 0;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #94a3b8;
  }
  .nexloyal-list {
    display: grid;
    gap: 10px;
  }
  .nexloyal-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #0f172a;
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 12px;
    padding: 12px 14px;
  }
  .nexloyal-row-title {
    font-size: 14px;
    font-weight: 600;
    color: #e2e8f0;
  }
  .nexloyal-row-sub {
    font-size: 12px;
    color: #94a3b8;
  }
  .nexloyal-row-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .nexloyal-row-icon {
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: #0b1324;
    display: grid;
    place-items: center;
    color: #38bdf8;
  }
  .nexloyal-row-icon svg,
  .nexloyal-row-chevron svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .nexloyal-row-chevron {
    width: 18px;
    height: 18px;
    color: #64748b;
  }
  .nexloyal-footer {
    background: #0b1324;
    border-top: 1px solid rgba(148, 163, 184, 0.18);
    padding: 14px 20px 18px;
  }
  .nexloyal-footer button {
    width: 100%;
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: #04111f;
    border: none;
    padding: 10px 16px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .nexloyal-form {
    display: grid;
    gap: 12px;
  }
  .nexloyal-form label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: #94a3b8;
    margin-bottom: 6px;
    display: block;
  }
  .nexloyal-input {
    width: 100%;
    padding: 10px 12px;
    border-radius: 10px;
    border: 1px solid rgba(148, 163, 184, 0.2);
    background: #0b1324;
    color: #e2e8f0;
    font-size: 13px;
  }
  .nexloyal-form-actions {
    display: flex;
    gap: 10px;
  }
  .nexloyal-secondary {
    background: transparent;
    color: #94a3b8;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }
  .nexloyal-loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 180px;
    color: #e2e8f0;
  }
  .nexloyal-spinner {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 3px solid rgba(148, 163, 184, 0.35);
    border-top-color: #38bdf8;
    animation: nexloyal-spin 1s linear infinite;
  }
  @keyframes nexloyal-spin {
    to { transform: rotate(360deg); }
  }
  #nexloyal-content button:not(.nexloyal-secondary) {
    background: linear-gradient(135deg, #0ea5e9, #38bdf8);
    color: #04111f;
    border: none;
    padding: 10px 16px;
    border-radius: 10px;
    font-size: 14px;
    cursor: pointer;
    width: 100%;
  }
  @media (max-width: 600px) {
    #nexloyal-widget {
      right: 16px;
      bottom: 16px;
    }
    #nexloyal-modal {
      padding: 12px;
      align-items: flex-end;
    }
    #nexloyal-panel {
      width: 100%;
      max-width: none;
      height: min(82vh, 620px);
      border-radius: 14px;
    }
  }
</style>

