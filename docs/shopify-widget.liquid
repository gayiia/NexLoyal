    function loadDashboard(token) {
      var dataUrl = config.dataUrl + '?token=' + encodeURIComponent(token);
      fetch(dataUrl, { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || typeof data.points === 'undefined') {
            throw new Error('Data missing');
          }
          renderDashboard(data);
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to load your rewards right now. Please try again.</p>';
        });
    }

    function renderLoggedIn(customer) {
      content.innerHTML = '' +
        '<div class="nexloyal-loading">' +
          '<div class="nexloyal-spinner" aria-label="Loading"></div>' +
        '</div>';

      var tokenUrl = config.tokenUrl +
        '?customer_id=' + encodeURIComponent(config.customerId || customer.id || '') +
        '&email=' + encodeURIComponent(config.customerEmail || customer.email || '') +
        '&shop_domain=' + encodeURIComponent(config.shopDomain);

      fetch(tokenUrl, { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(data) {
          if (!data || !data.token) {
            throw new Error('Token missing');
          }
          config.currentToken = data.token;
          loadDashboard(data.token);
        })
        .catch(function() {
          content.innerHTML = '<p>Unable to open the dashboard right now. Please try again.</p>';
        });
    }

    function renderProfileForm() {
      if (!config.currentToken) {
        content.innerHTML = '<p>Missing token. Please reopen the widget.</p>';
        return;
      }

      content.innerHTML = '' +
        '<div class="nexloyal-dashboard">' +
          '<div class="nexloyal-welcome">' +
            '<h2>Complete your profile</h2>' +
