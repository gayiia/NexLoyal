    function parseJsonResponse(response) {
      return response.text().then(function (text) {
        if (!text) {
          return { _ok: response.ok, _status: response.status };
        }
        try {
          var json = JSON.parse(text);
          json._ok = response.ok;
          json._status = response.status;
          return json;
        } catch (error) {
          return { message: text, _ok: response.ok, _status: response.status };
        }
      });
    }

    function postEarnSocial(platform) {
      return fetch(config.earnSocialUrl + '?token=' + encodeURIComponent(config.currentToken), {
        method: 'POST',
        mode: 'cors',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ platform: platform })
      }).then(parseJsonResponse);
    }

    function formatStatusLabel(status) {
      if (!status) {
        return 'Unused';
      }
      var normalized = status.toString().toLowerCase();
      if (normalized === 'used') {
        return 'Used';
      }
      if (normalized === 'in_progress') {
        return 'On hold';
      }
      if (normalized === 'expired') {
        return 'Expired';
      }
      return 'Unused';
    }

    function statusClassFromLabel(label) {
      if (label === 'Used') {
        return 'nexloyal-badge is-used';
      }
      if (label === 'On hold') {
        return 'nexloyal-badge is-hold';
      }
      if (label === 'Expired') {
        return 'nexloyal-badge is-used';
      }
      return 'nexloyal-badge is-unused';
    }

    function formatDateLabel(dateString) {
      if (!dateString) {
        return 'No expiry';
      }
      var date = new Date(dateString);
      if (isNaN(date.getTime())) {
        return 'No expiry';
      }
      return date.toISOString().slice(0, 10);
    }

    function maskCode(code) {
      if (!code) {
        return 'Code unavailable';
      }
      if (code.length <= 6) {
        return code;
      }
      return code.slice(0, 4) + '•••' + code.slice(-2);
    }

    function copyToClipboard(text, button) {
      if (!text) {
        return;
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function () {
          if (button) {
            button.textContent = 'Copied';
          }
        });
        return;
      }

      var tempInput = document.createElement('input');
      tempInput.value = text;
      document.body.appendChild(tempInput);
      tempInput.select();
      document.execCommand('copy');
      document.body.removeChild(tempInput);
      if (button) {
        button.textContent = 'Copied';
      }
    }

    function showToast(message) {
      if (!message) {
        return;
      }
      var existing = document.getElementById('nexloyal-toast');
      if (existing) {
        existing.parentElement.removeChild(existing);
      }
      var toast = document.createElement('div');
      toast.id = 'nexloyal-toast';
      toast.className = 'nexloyal-toast';
      toast.textContent = message;
      var panel = document.getElementById('nexloyal-panel');
      if (panel) {
        panel.appendChild(toast);
      }
      setTimeout(function () {
        if (toast.parentElement) {
          toast.parentElement.removeChild(toast);
        }
      }, 2200);
    }

    function checkChatEligibility(row) {
      if (!row || !config.currentToken) {
        return;
      }

      fetch(getChatMessagesUrl(null, 1), { method: 'GET', mode: 'cors' })
        .then(function(response) { return response.json(); })
        .then(function(payload) {
          var meta = payload && payload.meta ? payload.meta : {};
          if (meta.enabled === false || meta.allowed === false) {
            row.style.display = 'none';
          }
        })
        .catch(function() {});
    }

